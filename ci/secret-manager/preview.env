# What the scan job loads, one reference per secret. In a real repo the
# references point into a vault that only the scan's service account can
# read, and that vault holds credentials that can only read.
#
# Here the references are fake: .github/scripts/fake-secret-run.sh resolves
# them from a committed file of fake values. A line whose value starts with
# fake:// is a secret and is masked in the job log. Every other line is a
# plain value and is not masked.
FAKE_API_KEY=fake://examples-preview/webhook-api/key
FAKE_ENDPOINT=https://api.example.invalid
